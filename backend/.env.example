GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
ALLOWED_ORIGIN=http://localhost:5174
# Supabase (선택 — 없으면 backend/data/reports.json 시드로 동작)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Chroma (선택 — DB 담당이 적재한 벡터 컬렉션. 키 아님, 주소만)
# 서버 모드면 HOST/PORT, 파일 모드면 PATH 중 하나만 설정
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_PATH=
CHROMA_COLLECTION=reports

# 뉴스 보조 근거 (선택 — 없으면 리포트만으로 동작)
NEWSAPI_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
