# ─────────────────────────────────────────────────────────────
# 수집기 전용 환경변수
#
# 실제 값은 이 파일이 아니라 collector/.env 에 넣습니다.
# .env 는 .gitignore에 걸려 있어 커밋되지 않습니다.
#
# ⚠ 여기 있는 키는 절대 frontend/ 쪽으로 옮기지 마세요.
#   VITE_ 로 시작하는 변수는 빌드 결과물에 그대로 박혀서
#   브라우저 개발자도구로 누구나 꺼내 볼 수 있습니다.
#   임베딩은 반드시 이 수집기(로컬/서버)에서만 호출합니다.
# ─────────────────────────────────────────────────────────────

# 임베딩 — 아래 중 실제로 쓸 것 하나만 채우면 됩니다

# OpenAI (text-embedding-3-small · 1536차원 · $0.02/M)
OPENAI_API_KEY=

# AWS Bedrock (Titan Embeddings) — 캠프가 AWS 기반이면 이쪽
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# Supabase — 수집 결과를 DB로 올릴 때만 필요합니다.
# service_role 키는 RLS를 통째로 우회하므로 수집기에서만 쓰고,
# 프런트에는 절대 넣지 않습니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
